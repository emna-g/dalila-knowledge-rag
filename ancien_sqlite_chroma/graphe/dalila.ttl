<https://dalila.afi.nat.tn/ontologie> a owl:Ontology ;
    rdfs:comment "Ontologie de Dalila (AFI). Sans prix ni statut : ils restent dans MariaDB."@fr .

dal:aCahierDesCharges a owl:ObjectProperty ;
    rdfs:label "a pour cahier des charges"@fr ;
    rdfs:domain dal:ZoneIndustrielle ;
    rdfs:range dal:CahierDesCharges .

dal:aProximite a owl:ObjectProperty ;
    rdfs:label "a une proximité"@fr ;
    rdfs:domain dal:ZoneIndustrielle ;
    rdfs:range dal:Proximite .

dal:annee a owl:DatatypeProperty ;
    rdfs:label "année"@fr ;
    rdfs:domain dal:CahierDesCharges ;
    rdfs:range xsd:string .

dal:commoditeUtile a owl:ObjectProperty ;
    rdfs:label "commodité utile"@fr ;
    rdfs:domain dal:SecteurActivite ;
    rdfs:range dal:TypeCommodite .

dal:concerneDemarche a owl:ObjectProperty ;
    rdfs:label "concerne la démarche"@fr ;
    rdfs:domain dal:ServiceAFI ;
    rdfs:range dal:Demarche .

dal:dansGouvernorat a owl:ObjectProperty ;
    rdfs:label "dans le gouvernorat"@fr ;
    rdfs:domain dal:ZoneIndustrielle ;
    rdfs:range dal:Gouvernorat .

dal:dansZone a owl:ObjectProperty ;
    rdfs:label "dans la zone"@fr ;
    rdfs:domain dal:Lot ;
    rdfs:range dal:ZoneIndustrielle ;
    owl:inverseOf dal:contientLot .

dal:distanceKm a owl:DatatypeProperty ;
    rdfs:label "distance en km"@fr ;
    rdfs:domain dal:Proximite ;
    rdfs:range xsd:decimal .

dal:eligibleA a owl:ObjectProperty ;
    rdfs:label "éligible à"@fr ;
    rdfs:domain dal:ZoneIndustrielle ;
    rdfs:range dal:Incitation .

dal:ficheBaseConnaissances a owl:DatatypeProperty ;
    rdfs:label "fiche de la base de connaissances AFI"@fr ;
    rdfs:range xsd:integer .

dal:formeAValider a owl:DatatypeProperty ;
    rdfs:label "forme tunisienne à valider par un locuteur"@fr ;
    rdfs:range xsd:string .

dal:fourniPar a owl:ObjectProperty ;
    rdfs:label "fourni par"@fr ;
    rdfs:domain dal:ServiceAFI ;
    rdfs:range dal:Organisme .

dal:idAFI a owl:DatatypeProperty ;
    rdfs:label "identifiant dans la base AFI"@fr ;
    rdfs:range xsd:string .

dal:lienPDF a owl:DatatypeProperty ;
    rdfs:label "lien du PDF officiel"@fr ;
    rdfs:domain dal:CahierDesCharges ;
    rdfs:range xsd:anyURI .

dal:nomLieu a owl:DatatypeProperty ;
    rdfs:label "nom du lieu proche"@fr ;
