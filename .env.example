# Copier en .env (jamais dans git) et remplir les mots de passe.
# Base MariaDB 11.8 de Dalila : copie des tables de l'AFI (afi.sql, rafraîchie par dalila.connaissances.rafraichir_copie_afi)
# + nos tables dalila_*, agent_* et les vues v_pub_*.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afi
DB_ROOT_PASSWORD=
DB_RO_USER=dalila_ro
DB_RO_PASSWORD=
DB_RW_USER=dalila_rw
DB_RW_PASSWORD=
# Compte dédié aux chargements et à l'indexation; créé par la migration 004.
DB_INGEST_PASSWORD=
# Données hors git (défaut : donnees/ ; le corpus est dans donnees/corpus/)
# DALILA_DONNEES=
# Modèles d'embeddings téléchargés (défaut : modeles/)
# DALILA_MODELES=
# Modèle de recherche : E5 léger par défaut ; passer à bge ou qwen3 après validation de l'échantillon
DALILA_MODELE=e5
# DALILA_RERANKER=0
# Modèle Ollama de l'agent et adresse locale
DALILA_LLM=qwen3.5:4b
DALILA_LLM_URL=http://127.0.0.1:11434
