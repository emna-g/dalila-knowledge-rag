PREFIX dal: <https://afi.nat.tn/ontology/dalila#>
PREFIX d: <https://afi.nat.tn/ontology/dalila/donnees/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
# Commodité : services proches connus pour la zone Sidi Achour Borj El Amri (930508) ; distances dans la base
SELECT ?type WHERE { d:zone\/930508 dal:aServiceProche|dal:procheDe|dal:aEquipement ?t . ?t skos:prefLabel ?type }
