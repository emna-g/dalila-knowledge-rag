PREFIX dal: <https://afi.nat.tn/ontology/dalila#>
PREFIX d: <https://afi.nat.tn/ontology/dalila/donnees/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
# Lieu : les zones du gouvernorat de Sousse
SELECT ?zone ?nom WHERE { ?zone a dal:ZoneIndustrielle ; dal:dansGouvernorat ?g ; skos:prefLabel ?nom . ?g skos:prefLabel "Sousse"@fr . FILTER(LANG(?nom)="fr") }
